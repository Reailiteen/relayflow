{
  "name": "@relayflow/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web/index.ts",
    "./native": "./src/native/index.ts",
    "./admin": "./src/admin/index.ts",
    "./types": "./src/generated/database.types.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "generate:types": "../../scripts/generate-types.sh",
    "clean": "rm -rf .turbo *.tsbuildinfo",
    "db:push": "supabase db push --db-url \"$SUPABASE_DB_URL\""
  },
  "dependencies": {
    "@relayflow/core": "workspace:*",
    "@relayflow/entities": "workspace:*",
    "@relayflow/logger": "workspace:*",
    "@relayflow/ports": "workspace:*",
    "@supabase/supabase-js": "catalog:"
  },
  "peerDependencies": {
    "@supabase/ssr": "^0.8.0"
  },
  "peerDependenciesMeta": {
    "@supabase/ssr": {
      "optional": true
    }
  },
  "devDependencies": {
    "@relayflow/config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
