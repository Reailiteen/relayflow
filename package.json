{
  "name": "relayflow",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@relayflow/web",
    "dev:mobile": "turbo run dev --filter=@relayflow/mobile",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verify": "turbo run typecheck lint test build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,sql}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "seed:hosted": "tsx scripts/seed-hosted.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json"
  },
  "devDependencies": {
    "@relayflow/config": "workspace:*",
    "@relayflow/data": "workspace:*",
    "@relayflow/fixtures": "workspace:*",
    "prettier": "catalog:",
    "tsx": "^4.20.3",
    "turbo": "^2.5.8",
    "typescript": "catalog:"
  }
}
