# React Native / Metro does not follow pnpm's symlinked store reliably.
# Hoisting keeps Expo, Metro and Next resolving identically.
node-linker=hoisted

# Workspace packages always resolve to the local copy, never the registry.
link-workspace-packages=true
prefer-workspace-packages=true
save-workspace-protocol=rolling

# Fail loudly on peer mismatches instead of shipping a subtly broken tree.
strict-peer-dependencies=false
auto-install-peers=true
