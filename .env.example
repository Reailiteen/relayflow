# Nothing here is required yet.
#
# The apps run on in-memory fixtures (@relayflow/fixtures), so `pnpm dev:web`
# and `pnpm dev:mobile` work on a fresh clone with no configuration at all.
# This file documents what the backend will need when we wire it up.
#
# Note which keys carry which prefix: NEXT_PUBLIC_ and EXPO_PUBLIC_ values are
# inlined into shipped bundles and readable by anyone with the app. Only the
# anon key belongs there — it is designed to be public, because row-level
# security is what actually protects the data behind it.

# --- Public (safe to ship in client bundles) --------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server only ------------------------------------------------------------
# Read exclusively by @relayflow/data/admin, which apps cannot import. This key
# bypasses row-level security entirely: it must never appear in a client bundle,
# a NEXT_PUBLIC_/EXPO_PUBLIC_ variable, or a log line.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Tooling only -----------------------------------------------------------
# Connection string for the HOSTED project (Project Settings → Database →
# Connection string → URI). Used by `db:push` and `generate:types`.
#
# There is no local stack: no `supabase start`, no Docker. Contains the database
# password, so it stays out of the apps entirely — no runtime code reads it.
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres
